---
/**
 * Character Card (Story 2.3): the second screen of /next, the target of ▶ Start and the key advance.
 * Static, zero JS: the 256 px portrait in a black square frame, label/value rows (Class, School, Home,
 * Next Quest, Equipment), the 4 interests with their legacy icons, and a native <details>
 * "Training ▸ {n} courses" listing the completed courses with topic chips (D8: no planned courses).
 * Every string comes from profile.json / coursework.json / stations.json / ui.json, passed in as props (AD-2).
 */
import Chip from './ui/Chip.astro';
import Pill from './ui/Pill.astro';
import InterestIcon from './icons/InterestIcon.astro';

interface Props {
  /** The `character` screen title from stations.json ("Character Card"). */
  title: string;
  profile: {
    class: string;
    character: {
      institution: string;
      degree: string;
      specialization: string;
      standing: string;
      home: string;
      nextQuest: string;
      equipment: string[];
    };
    certifications: Array<{ code: string; name: string }>;
    interests: Array<{ id: string; title: string; icon: 'atom' | 'film-stack' | 'node-graph' | 'line-chart' }>;
  };
  courses: Array<{ id: string; code: string; title: string; status: 'completed'; topics: string[] }>;
  ui: {
    charClass: string;
    charSchool: string;
    charHome: string;
    charNextQuest: string;
    charEquipment: string;
    charInterests: string;
    training: string;
    courses: string;
    statusNext: string;
  };
}

const { title, profile, courses, ui } = Astro.props;
const c = profile.character;

const school = [c.institution, c.degree, c.specialization, c.standing].join(' · ');
const equipment = c.equipment.map((code) => ({
  code,
  name: profile.certifications.find((cert) => cert.code === code)?.name,
}));
const completed = courses.filter((course) => course.status === 'completed');
---
<section id="character" class="char" aria-labelledby="character-title">
  <div class="char__panel">
    <h2 id="character-title" class="char__title">{title}</h2>

    <div class="char__top">
      <div class="char__frame">
        <img
          src="/assets/character/sneha-portrait-256.webp"
          srcset="/assets/character/sneha-portrait-256.webp 256w, /assets/character/sneha-portrait-512.webp 512w"
          sizes="(max-width: 599px) 192px, 256px"
          width="256"
          height="256"
          alt=""
          loading="lazy"
          decoding="async"
        />
      </div>

      <dl class="char__rows">
        <div class="char__row">
          <dt>{ui.charClass}</dt>
          <dd>{profile.class}</dd>
        </div>
        <div class="char__row">
          <dt>{ui.charSchool}</dt>
          <dd>{school}</dd>
        </div>
        <div class="char__row">
          <dt>{ui.charHome}</dt>
          <dd>{c.home}</dd>
        </div>
        <div class="char__row">
          <dt>{ui.charNextQuest}</dt>
          <dd class="char__next"><Pill status="next">{ui.statusNext}</Pill> <span>{c.nextQuest}</span></dd>
        </div>
        <div class="char__row">
          <dt>{ui.charEquipment}</dt>
          <dd>
            <ul class="char__badges">
              {
                equipment.map((item) => (
                  <li>
                    <abbr class="badge" title={item.name}>{item.code}</abbr>
                  </li>
                ))
              }
            </ul>
          </dd>
        </div>
      </dl>
    </div>

    <dl class="char__rows char__rows--wide">
      <div class="char__row">
        <dt>{ui.charInterests}</dt>
        <dd>
          <ul class="char__interests">
            {
              profile.interests.map((interest) => (
                <li class="interest">
                  <InterestIcon icon={interest.icon} />
                  <span>{interest.title}</span>
                </li>
              ))
            }
          </ul>
        </dd>
      </div>
    </dl>

    <details class="training">
      <summary class="training__summary">
        {ui.training} <span class="training__chevron" aria-hidden="true">▸</span> {completed.length} {ui.courses}
      </summary>
      <ul class="training__list">
        {
          completed.map((course) => (
            <li class="course" data-course={course.id}>
              <p class="course__head">
                <span class="course__code">{course.code}</span> <span class="course__title">{course.title}</span>
              </p>
              <ul class="course__topics">
                {course.topics.map((topic) => (
                  <li>
                    <Chip>{topic}</Chip>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </details>
  </div>
</section>

<style>
  .char {
    display: flex;
    align-items: center;
    min-height: 100vh;
    min-height: 100svh;
    padding: var(--space-6) var(--space-gutter-mobile);
  }

  /* The Glance Card's key advance focuses #character (tabindex="-1"); it is not a control, so no ring. */
  .char:focus {
    outline: none;
  }

  .char__panel {
    width: 100%;
    max-width: var(--space-content-max);
    margin: 0 auto;
    padding: var(--space-4);
    border: var(--space-border) solid var(--color-edge);
    background: var(--color-panel);
    box-shadow: var(--space-drop) var(--space-drop) 0 var(--color-edge);
  }

  .char__title {
    margin: 0 0 var(--space-5);
    color: var(--color-text);
    font-family: var(--type-station-title-family);
    font-size: var(--type-station-title-size);
    font-weight: var(--type-station-title-weight);
    line-height: var(--type-station-title-line-height);
    letter-spacing: var(--type-station-title-letter-spacing);
    text-transform: var(--type-station-title-transform);
    text-shadow: var(--type-station-title-shadow);
  }

  .char__top {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .char__frame {
    align-self: center;
    flex: none;
    border: 6px solid var(--color-edge);
    background: var(--color-inset);
    line-height: 0;
  }

  .char__frame img {
    display: block;
    width: 192px;
    height: auto;
    aspect-ratio: 1;
  }

  .char__rows {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-width: 0;
    margin: 0;
  }

  .char__rows--wide {
    margin-top: var(--space-5);
  }

  .char__row {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 0;
  }

  .char__row dt {
    color: var(--color-dim);
    font-family: var(--type-label-family);
    font-size: var(--type-label-size);
    font-weight: var(--type-label-weight);
    letter-spacing: var(--type-label-letter-spacing);
    text-transform: uppercase;
  }

  .char__row dd {
    min-width: 0;
    margin: 0;
    color: var(--color-text);
    overflow-wrap: break-word;
  }

  .char__next {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-weight: 600;
  }

  .char__badges,
  .char__interests,
  .training__list,
  .course__topics {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .char__badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  /* Certification badge: an inset block with a gold mono code; the full name is the <abbr title>. */
  .badge {
    display: inline-block;
    padding: var(--space-1) var(--space-2);
    border: var(--space-border-sm) solid var(--color-edge);
    background: var(--color-inset);
    color: var(--color-gold);
    font-family: var(--type-label-family);
    font-size: var(--type-label-size);
    font-weight: 800;
    letter-spacing: var(--type-label-letter-spacing);
    text-decoration: none;
    cursor: help;
  }

  /* One column on phones: two would split "Nanoelectronics" mid-word at 360–390 px. */
  .char__interests {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2);
  }

  .interest {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
    padding: var(--space-2);
    border: var(--space-border-sm) solid var(--color-edge);
    background: var(--color-inset);
    color: var(--color-text);
    font-weight: 600;
  }

  .training {
    margin-top: var(--space-5);
    border: var(--space-border-sm) solid var(--color-edge);
    background: var(--color-inset);
  }

  .training__summary {
    display: flex;
    align-items: center;
    min-height: var(--space-touch-min);
    padding: var(--space-2) var(--space-3);
    color: var(--color-text);
    font-family: var(--type-label-family);
    font-size: var(--type-button-size);
    font-weight: var(--type-button-weight);
    letter-spacing: var(--type-button-letter-spacing);
    text-transform: uppercase;
    cursor: pointer;
    list-style: none;
  }

  /* The summary text carries its own ▸; hide the browser's disclosure marker. */
  .training__summary::-webkit-details-marker {
    display: none;
  }

  .training__chevron {
    display: inline-block;
    margin-inline: 0.5ch;
  }

  /* Open vs closed: the ▸ points down while the list is open. */
  .training[open] .training__chevron {
    transform: rotate(90deg);
  }

  .training__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-2) var(--space-3) var(--space-4);
  }

  .course__head {
    margin: 0 0 var(--space-2);
    color: var(--color-text);
  }

  .course__code {
    color: var(--color-gold);
    font-family: var(--type-label-family);
    font-weight: 800;
  }

  .course__title {
    font-weight: 600;
  }

  .course__topics {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  @media (min-width: 600px) {
    .char {
      padding-inline: var(--space-gutter-desktop);
    }

    .char__panel {
      padding: var(--space-5);
    }

    .char__top {
      flex-direction: row;
      align-items: flex-start;
      gap: var(--space-6);
    }

    .char__frame {
      align-self: flex-start;
    }

    .char__frame img {
      width: 256px;
    }

    .char__rows--wide,
    .char__top .char__rows {
      flex: 1;
    }

    .char__row {
      display: grid;
      grid-template-columns: 9rem minmax(0, 1fr);
      align-items: center;
      gap: var(--space-3);
    }

    .char__interests {
      grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    }
  }
</style>
