---
/**
 * Glance Card (Story 2.2): the whole pitch on the first screen of /next, pre-rendered, zero islands.
 * Portrait on a grass plinth over a Sky Plains backdrop; class line, the page's only <h1>, tagline,
 * availability with a → NEXT pill, 3 Proof Tiles, and the only two buttons (▶ Start, Résumé).
 * Every string comes from profile.json / ui.json, passed in as props (AD-2).
 * A tiny inline script advances to #track on ↓ / Space / PageDown (and Enter on <body>) while the card is
 * in view; ▶ Start is a plain #track link, so everything works without JS.
 */
import Button from './ui/Button.astro';
import Pill from './ui/Pill.astro';

interface Props {
  profile: {
    name: string;
    class: string;
    school: string;
    tagline: string;
    portraitAlt: string;
    availability: { short: string };
    proofTiles: Array<{ value: string; label: string }>;
    contact: { resume: string };
  };
  ui: {
    start: string;
    resume: string;
    statusNext: string;
    opensInNewTab: string;
  };
  /** id of the section the card advances to. */
  next?: string;
}

const { profile, ui, next = 'track' } = Astro.props;

/* Backdrop geometry (viewBox 1280×800, anchored bottom-centre). Ground: grass strip + dirt band. */
const GROUND = 640;
const clouds = [
  [120, 96, 160, 32], [160, 64, 80, 32],
  [520, 152, 192, 32], [568, 120, 96, 32],
  [960, 80, 176, 32], [1000, 48, 64, 32],
];
/** Stepped hill rows, back to front: [x, top, width] blocks standing on the ground line. */
const hills = {
  far: [[0, 440, 240], [80, 400, 120], [360, 460, 280], [440, 420, 120], [760, 430, 300], [840, 380, 140], [1120, 450, 160]],
  mid: [[0, 520, 200], [40, 490, 80], [280, 540, 260], [340, 500, 120], [700, 520, 220], [760, 480, 100], [1040, 510, 240], [1100, 470, 100]],
  near: [[120, 590, 240], [180, 570, 100], [560, 600, 200], [880, 580, 260], [940, 556, 120]],
};
const pebbles = [[60, 700], [300, 740], [520, 690], [760, 750], [980, 700], [1200, 740]];
---
<section id="glance" class="glance" aria-labelledby="glance-name" data-next={next}>
  <svg
    class="glance__backdrop"
    aria-hidden="true"
    focusable="false"
    viewBox="0 0 1280 800"
    preserveAspectRatio="xMidYMax slice"
    shape-rendering="crispEdges"
  >
    <rect class="bd-sky" x="0" y="0" width="1280" height="800" />
    {clouds.map(([x, y, w, h]) => <rect class="bd-cloud" x={x} y={y} width={w} height={h} />)}
    {hills.far.map(([x, y, w]) => <rect class="bd-hill-far" x={x} y={y} width={w} height={GROUND - y} />)}
    {hills.mid.map(([x, y, w]) => <rect class="bd-hill-mid" x={x} y={y} width={w} height={GROUND - y} />)}
    {hills.near.map(([x, y, w]) => <rect class="bd-hill-near" x={x} y={y} width={w} height={GROUND - y} />)}
    <rect class="bd-grass" x="0" y={GROUND} width="1280" height="10" />
    <rect class="bd-grass-dark" x="0" y={GROUND + 10} width="1280" height="10" />
    {/* Dirt is painted with strokes: tokens.test bans dirt in `fill` (text) declarations. */}
    <path class="bd-dirt" d={`M0 ${GROUND + 100}H1280`} />
    {pebbles.map(([x, y]) => <path class="bd-pebble" d={`M${x} ${y + 10}h20`} />)}
  </svg>

  <div class="glance__inner">
    <div class="glance__portrait">
      <div class="glance__frame">
        <img
          src="/assets/character/sneha-portrait-512.webp"
          srcset="/assets/character/sneha-portrait-256.webp 256w, /assets/character/sneha-portrait-512.webp 512w"
          sizes="(max-width: 599px) 180px, (max-width: 899px) 240px, 340px"
          width="512"
          height="512"
          alt={profile.portraitAlt}
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </div>
      <div class="glance__plinth" aria-hidden="true"></div>
    </div>

    <div class="glance__text">
      <p class="glance__class">{profile.class} · {profile.school}</p>
      <h1 id="glance-name" class="glance__name">{profile.name}</h1>
      <p class="glance__tagline">{profile.tagline}</p>
      <p class="glance__avail"><Pill status="next">{ui.statusNext}</Pill> <span>{profile.availability.short}</span></p>

      <ul class="glance__tiles">
        {
          profile.proofTiles.map((tile) => (
            <li class="tile">
              <span class="tile__value">{tile.value}</span>
              <span class="tile__label">{tile.label}</span>
            </li>
          ))
        }
      </ul>

      <div class="glance__actions">
        <Button variant="grass" href={`#${next}`}>{ui.start}</Button>
        <Button variant="gold" href={profile.contact.resume} newTab={ui.opensInNewTab}>{ui.resume}</Button>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var card = document.getElementById('glance');
    if (!card) return;
    var nextId = card.getAttribute('data-next') || '';
    var KEYS = ['ArrowDown', 'PageDown', ' ', 'Spacebar', 'Enter'];
    var TEXT = /^(INPUT|TEXTAREA|SELECT|BUTTON|SUMMARY)$/;
    document.addEventListener('keydown', function (e) {
      if (e.defaultPrevented || e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
      if (KEYS.indexOf(e.key) === -1) return;
      var el = document.activeElement;
      if (el && (el.isContentEditable || TEXT.test(el.tagName))) return;
      if (e.key === 'Enter' && el !== document.body && el !== null) return;
      // #track is resolved here: this script runs before it is parsed.
      var target = document.getElementById(nextId);
      if (!target) return;
      // Only while the Glance Card is on screen (scrollY above #track) and the page can still scroll.
      var root = document.documentElement;
      if (target.getBoundingClientRect().top <= 1) return;
      if (window.scrollY + window.innerHeight >= root.scrollHeight - 1) return;
      e.preventDefault();
      target.scrollIntoView();
      // Move the keyboard start point too, so the next Tab continues from #track (the URL is left alone).
      if (!target.hasAttribute('tabindex')) target.setAttribute('tabindex', '-1');
      target.focus({ preventScroll: true });
    });
  })();
</script>

<style>
  .glance {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 100vh;
    min-height: 100svh;
    overflow: hidden;
    background: var(--color-sky);
  }

  .glance__backdrop {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .bd-sky {
    fill: var(--color-sky);
  }
  .bd-cloud {
    fill: var(--color-snow);
  }
  .bd-hill-far {
    fill: var(--color-grass-light);
  }
  .bd-hill-mid {
    fill: var(--color-grass);
  }
  .bd-hill-near {
    fill: var(--color-grass-dark);
  }
  .bd-grass {
    fill: var(--color-grass);
  }
  .bd-grass-dark {
    fill: var(--color-grass-dark);
  }
  .bd-dirt {
    stroke: var(--color-dirt-dark);
    stroke-width: 160;
  }
  .bd-pebble {
    stroke: var(--color-dirt);
    stroke-width: 20;
  }

  .glance__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    width: 100%;
    max-width: var(--space-content-max);
    margin: 0 auto;
    padding: var(--space-4) var(--space-gutter-mobile);
  }

  /* Portrait: 6 px black frame standing on a grass-block plinth. */
  .glance__portrait {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: none;
  }

  .glance__frame {
    position: relative;
    z-index: 1;
    border: 6px solid var(--color-edge);
    background: var(--color-panel);
    line-height: 0;
  }

  .glance__frame img {
    display: block;
    width: 180px;
    height: auto;
    aspect-ratio: 1;
  }

  .glance__plinth {
    width: calc(100% + var(--space-6));
    height: var(--space-6);
    margin-top: calc(-1 * var(--space-border));
    border: var(--space-border) solid var(--color-edge);
    background: linear-gradient(
      var(--color-grass) 0 8px,
      var(--color-grass-dark) 8px 16px,
      var(--color-dirt-dark) 16px
    );
  }

  /* Text column: a panel block so every line keeps AA contrast over the bright sky. */
  .glance__text {
    width: 100%;
    max-width: 600px;
    padding: var(--space-3);
    border: var(--space-border) solid var(--color-edge);
    background: var(--color-panel);
    box-shadow: var(--space-drop) var(--space-drop) 0 var(--color-edge);
  }

  .glance__class {
    margin: 0 0 var(--space-2);
    color: var(--color-muted);
    font-family: var(--type-label-family);
    font-size: var(--type-label-size);
    font-weight: var(--type-label-weight);
    letter-spacing: var(--type-label-letter-spacing);
    text-transform: uppercase;
  }

  .glance__name {
    margin: 0;
    color: var(--color-text);
    font-family: var(--type-display-family);
    font-size: var(--type-display-size);
    font-weight: var(--type-display-weight);
    line-height: var(--type-display-line-height);
    letter-spacing: var(--type-display-letter-spacing);
    text-transform: var(--type-display-transform);
    text-shadow: var(--type-display-shadow);
  }

  .glance__tagline {
    margin: var(--space-2) 0 var(--space-3);
    color: var(--color-text);
    font-size: 1.1rem;
  }

  .glance__avail {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin: 0 0 var(--space-4);
    color: var(--color-text);
    font-weight: 600;
  }

  .glance__tiles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2);
    margin: 0 0 var(--space-4);
    padding: 0;
    list-style: none;
  }

  /* Metric tile (DESIGN metric-tile): inset, 3 px edge, 4 px dirt-dark top strip, gold number, muted label. */
  .tile {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: calc(var(--space-2) + var(--space-1)) var(--space-2) var(--space-2);
    border: var(--space-border-sm) solid var(--color-edge);
    background: var(--color-inset);
    box-shadow: inset 0 var(--space-border) 0 var(--color-dirt-dark);
  }

  .tile__value {
    color: var(--color-gold);
    font-family: var(--type-metric-family);
    font-size: clamp(0.9rem, 4vw, var(--type-metric-size));
    font-weight: var(--type-metric-weight);
    line-height: var(--type-metric-line-height);
    white-space: nowrap;
  }

  .tile__label {
    color: var(--color-muted);
    font-family: var(--type-label-family);
    font-size: var(--type-label-size);
    font-weight: var(--type-label-weight);
    line-height: 1.3;
  }

  .glance__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  @media (min-width: 600px) {
    .glance__inner {
      flex-direction: row-reverse;
      justify-content: space-between;
      gap: var(--space-6);
      padding: var(--space-7) var(--space-gutter-desktop);
    }

    .glance__frame img {
      width: 340px;
    }

    .glance__text {
      padding: var(--space-5);
    }

    .glance__plinth {
      height: var(--space-7);
      background: linear-gradient(
        var(--color-grass) 0 12px,
        var(--color-grass-dark) 12px 24px,
        var(--color-dirt-dark) 24px
      );
    }
  }

  @media (min-width: 600px) and (max-width: 899px) {
    .glance__inner {
      flex-direction: column;
    }
    .glance__frame img {
      width: 240px;
    }
  }
</style>
